{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://absel.org/schema/exercise/1.0/manifest.schema.json",
  "title": "ABSEL Exercise Library manifest",
  "description": "Indexing information for one exercise. Saved as manifest.json in the exercise's folder. Field rules and definitions of every allowed value are in schema/INDEXING-RULES.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "title", "slug", "summary", "authors",
    "exercise_types", "disciplines", "topics", "learning_objectives",
    "levels", "delivery_modes", "duration", "class_size", "materials",
    "rights", "license", "version", "author_confirmed"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },

    "title": { "type": "string", "minLength": 5, "maxLength": 120 },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "Folder name and URL. Lowercase words joined by hyphens."
    },
    "summary": {
      "type": "string",
      "minLength": 300,
      "maxLength": 1400,
      "description": "60-180 words for an instructor deciding whether to use the exercise. Shown publicly in the catalog."
    },
    "description": {
      "type": ["string", "null"],
      "maxLength": 6000,
      "description": "Optional longer overview for members. Never include confidential information such as answer keys."
    },

    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "affiliation": { "type": ["string", "null"] },
          "email": { "type": ["string", "null"], "format": "email", "description": "Private: used by editors, never displayed." },
          "orcid": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$" },
          "corresponding": { "type": "boolean", "default": false }
        }
      }
    },

    "exercise_types": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": { "enum": [
        "simulation", "role-play", "game", "case-discussion", "structured-exercise",
        "team-project", "field-assignment", "reflection-or-debrief-tool", "assessment-instrument"
      ] }
    },
    "disciplines": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "description": "First item is the primary discipline.",
      "items": { "enum": [
        "accounting", "business-analytics", "business-communication", "business-ethics",
        "business-law", "economics", "entrepreneurship", "finance", "general-management",
        "human-resource-management", "information-systems", "international-business",
        "leadership", "marketing", "negotiation", "operations-management",
        "organizational-behavior", "project-management", "strategy",
        "supply-chain-management", "sustainability"
      ] }
    },
    "courses": {
      "type": "array", "maxItems": 5, "uniqueItems": true,
      "description": "Typical course titles, free text, e.g. \"Principles of Marketing\".",
      "items": { "type": "string", "minLength": 3, "maxLength": 80 }
    },
    "topics": {
      "type": "array", "minItems": 3, "maxItems": 12, "uniqueItems": true,
      "description": "Search keywords: concepts an instructor would type.",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9 &'/-]*$", "maxLength": 40 }
    },
    "learning_objectives": {
      "type": "array", "minItems": 2, "maxItems": 8,
      "items": { "type": "string", "minLength": 15, "maxLength": 300 }
    },
    "skills": {
      "type": "array", "maxItems": 5, "uniqueItems": true,
      "items": { "enum": [
        "written-communication", "oral-communication", "critical-thinking",
        "quantitative-reasoning", "data-literacy", "ethical-reasoning", "teamwork",
        "leadership", "decision-making", "negotiation-and-persuasion",
        "cross-cultural-competence", "creativity-and-innovation", "technology-agility",
        "ai-literacy", "reflective-thinking"
      ] }
    },

    "levels": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": [
        "undergraduate-introductory", "undergraduate-advanced", "graduate",
        "executive-education", "doctoral"
      ] }
    },
    "delivery_modes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["in-person", "online-synchronous", "online-asynchronous", "hybrid"] }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_class_minutes", "sessions"],
      "properties": {
        "in_class_minutes": { "$ref": "#/$defs/range", "description": "Total class time across all sessions, including debrief. 0 if none." },
        "sessions": { "type": "integer", "minimum": 1 },
        "out_of_class_hours": { "type": ["number", "null"], "minimum": 0, "description": "Student time outside class." }
      }
    },
    "class_size": { "$ref": "#/$defs/range", "description": "Students in the whole class. max null means no upper limit." },
    "group_size": { "$ref": "#/$defs/range", "description": "Students per team. 1-1 means individual work." },
    "prep_time_minutes": { "type": ["integer", "null"], "minimum": 0, "description": "Instructor preparation the first time." },
    "technology": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": [
        "none", "projector", "student-devices", "internet", "lms",
        "spreadsheet-software", "specialized-software"
      ] }
    },
    "technology_notes": { "type": ["string", "null"], "maxLength": 500 },
    "cost_to_students": { "enum": ["free", "under-25", "25-to-75", "over-75"] },
    "ai_involvement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic_is_ai", "students_use_ai"],
      "properties": {
        "topic_is_ai": { "type": "boolean", "description": "The exercise teaches about AI." },
        "students_use_ai": { "enum": ["none", "optional", "required"] },
        "notes": { "type": ["string", "null"], "maxLength": 500 }
      }
    },

    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "role", "audience"],
        "anyOf": [{ "required": ["file"] }, { "required": ["url"] }],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^(?![_.])(?!.*\\.\\.)(?!.*/[_.])[A-Za-z0-9._ /-]+$",
            "description": "File name within the exercise folder. No leading _ or ."
          },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "title": { "type": "string", "minLength": 3, "maxLength": 120 },
          "role": { "enum": [
            "instructor-guide", "teaching-notes", "answer-key", "debrief-guide",
            "student-instructions", "role-brief", "case-text", "reading", "slides",
            "simulation", "data-file", "template-or-worksheet", "rubric", "assessment",
            "video", "other"
          ] },
          "audience": { "enum": ["instructor-only", "student-facing"] },
          "notes": { "type": ["string", "null"], "maxLength": 300 }
        },
        "if": { "properties": { "role": { "enum": ["instructor-guide", "teaching-notes", "answer-key"] } } },
        "then": { "properties": { "audience": { "const": "instructor-only" } } }
      }
    },

    "classroom_testing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["times_used"],
      "properties": {
        "times_used": { "type": "integer", "minimum": 0 },
        "contexts": { "type": ["string", "null"], "maxLength": 500, "description": "Courses, levels and class sizes it was used with." }
      }
    },
    "evidence_of_effectiveness": { "type": ["string", "null"], "maxLength": 1500 },
    "prior_publications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["citation"],
        "properties": {
          "citation": { "type": "string", "minLength": 10 },
          "doi": { "type": ["string", "null"], "pattern": "^10\\.\\d{4,9}/\\S+$" },
          "url": { "type": ["string", "null"], "format": "uri" }
        }
      }
    },

    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author_owns_or_has_permission", "third_party_materials", "contains_identifiable_student_information"],
      "properties": {
        "author_owns_or_has_permission": { "type": "boolean" },
        "third_party_materials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "status"],
            "properties": {
              "description": { "type": "string", "minLength": 5 },
              "status": { "enum": ["permission-obtained", "openly-licensed", "public-domain", "needs-review"] }
            }
          }
        },
        "contains_identifiable_student_information": {
          "const": false,
          "description": "Must be false. Remove student names, grades and identifiable work before submitting."
        }
      }
    },
    "license": { "enum": ["absel-member-use", "cc-by-nc-4.0", "cc-by-nc-sa-4.0", "cc-by-4.0"] },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" },
    "version_notes": { "type": ["string", "null"], "maxLength": 1000 },

    "generated_with": { "type": ["string", "null"], "maxLength": 80, "description": "AI tool that drafted this manifest, if any." },
    "author_confirmed": { "type": "boolean", "description": "Set to true only by the submission form after the author reviews every field." }
  },

  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
